"  -v, --verbose                         Auk detaljnivået med eitt steg\n"
"      --version                         Vis versjonen\n"
"  -c, --config                          Last inn oppsett (standard %s)\n"
"  -P  --properties                      Set kontekst-eigenskapar\n"

