"  -p, --playback                        Avspelingsmodus\n"
"  -r, --record                          Opptaksmodus\n"
"  -m, --midi                            MIDI-modus\n"
"  -d, --dsd                             DSD-modus\n"
"  -o, --encoded                         Koda modus\n"
"  -s, --sysex                           SysEx-modus\n"
"  -c, --midi-clip                       MIDI-klipp-modus\n"
"\n"

