#: src/tools/pw-cat.c:1191
#, c-format
msgid ""
"  -R, --remote                          Remote daemon name\n"
"      --media-type                      Set media type (default %s)\n"
"      --media-category                  Set media category (default %s)\n"
"      --media-role                      Set media role (default %s)\n"
"      --target                          Set node target serial or name "
"(default %s)\n"
"                                          0 means don't link\n"
"  -C  --monitor                         Capture monitor ports (in recording "
"mode)\n"
"      --latency                         Set node latency (default %s)\n"
"                                          Xunit (unit = s, ms, us, ns)\n"
"                                          or direct samples (256)\n"
"                                          the rate is the one of the source "
"file\n"
"  -P  --properties                      Set node properties\n"
"\n"
msgstr ""
"  -R, --remote                          Navn på fjerntjenesten\n"
"      --media-type                      Sett medietype (standard %s)\n"
"      --media-category                  Sett mediekategori (standard %s)\n"
"      --media-role                      Sett medierolle (standard %s)\n"
"      --target                          Sett serienummer eller navn på målnoden (standard %s)\n"
"                                          0 betyr: ikke koble\n"
"  -C  --monitor                         Ta opp monitorporter (i opptaksmodus)\n"
"      --latency                         Sett latens for noden (standard %s)\n"
"                                          Xunit (enhet = s, ms, us, ns)\n"
"                                          eller sampler direkte (256)\n"
"                                          raten er den samme som i kildefilen\n"
"  -P  --properties                      Sett nodeegenskaper\n"
"\n"

#: src/tools/pw-cat.c:1210
#, c-format
msgid ""
"      --rate                            Sample rate (default %u)\n"
"      --channels                        Number of channels (default %u)\n"
"      --channel-map                     Channel map\n"
"                                            a channel layout: \"Stereo\", "
"\"5.1\",... or\n"
"                                            comma separated list of channel "
"names: eg. \"FL,FR\"\n"
"      --list-layouts                    List supported channel layouts\n"
"      --list-channel-names              List supported channel maps\n"
"      --format                          Sample format (default %s)\n"
"      --list-formats                    List supported sample formats\n"
"      --container                       Container format\n"
"      --list-containers                 List supported containers and "
"extensions\n"
"      --volume                          Stream volume 0-1.0 (default %.3f)\n"
"  -q  --quality                         Resampler quality (0 - 15) (default "
"%d)\n"
"  -a, --raw                             RAW mode\n"
"  -M, --force-midi                      Force midi format, one of \"none\", "
"\"midi\" or \"ump\", (default none)\n"
"  -n, --sample-count COUNT              Stop after COUNT samples\n"
"\n"
msgstr ""
"      --rate                            Samplerate (standard %u)\n"
"      --channels                        Antall kanaler (standard %u)\n"
"      --channel-map                     Kanalkart\n"
"                                            et kanaloppsett: \"Stereo\", \"5.1\",... eller\n"
"                                            kommaseparert liste med kanalnavn: f.eks. \"FL,FR\"\n"
"      --list-layouts                    List opp støttede kanaloppsett\n"
"      --list-channel-names              List opp støttede kanalkart\n"
"      --format                          Sampleformat (standard %s)\n"
"      --list-formats                    List opp støttede sampleformater\n"
"      --container                       Containerformat\n"
"      --list-containers                 List opp støttede containere og filendelser\n"
"      --volume                          Strømvolum 0-1.0 (standard %.3f)\n"
"  -q  --quality                         Kvalitet for omsampling (0 - 15) (standard %d)\n"
"  -a, --raw                             RAW-modus\n"
"  -M, --force-midi                      Tving midi-format, en av \"none\", \"midi\" eller \"ump\" (standard none)\n"
"  -n, --sample-count COUNT              Stopp etter COUNT sampler\n"
"\n"

#: src/tools/pw-cat.c:1235
msgid ""
"  -p, --playback                        Playback mode\n"
"  -r, --record                          Recording mode\n"
"  -m, --midi                            Midi mode\n"
"  -d, --dsd                             DSD mode\n"
"  -o, --encoded                         Encoded mode\n"
"  -s, --sysex                           SysEx mode\n"
"  -c, --midi-clip                       MIDI clip mode\n"
"\n"
msgstr ""
"  -p, --playback                        Avspillingsmodus\n"
"  -r, --record                          Opptaksmodus\n"
"  -m, --midi                            MIDI-modus\n"
"  -d, --dsd                             DSD-modus\n"
"  -o, --encoded                         Kodet modus\n"
"  -s, --sysex                           SysEx-modus\n"
"  -c, --midi-clip                       MIDI-klipp-modus\n"
"\n"

