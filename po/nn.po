msgid ""
"%s [options]\n"
"  -h, --help                            Show this help\n"
"  -v, --verbose                         Increase verbosity by one level\n"
"      --version                         Show version\n"
"  -c, --config                          Load config (Default %s)\n"
"  -P  --properties                      Set context properties\n"
msgstr ""
"%s [val]\n"
